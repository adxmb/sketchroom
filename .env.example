# Copy to server/.env and export these before you run the server (set -a; source .env; set +a)
DATABASE_URL=postgres://sketch:sketch@localhost:5433/sketchroom
PORT=3000

# Optional. They are for a deploy, not for local work.
# STATIC_DIR=/app/client/dist     # folder with the built client. The server then serves the whole site
# NODE_ENV=production             # turns on secure cookies (HTTPS only)
# SECURE_COOKIES=false            # "false" lets you test the production image over http://localhost
# TRUST_PROXY=uniquelocal         # proxies to trust for X-Forwarded-For. See the deploy steps
# ALLOWED_ORIGINS=                # extra origins for the WebSocket, comma separated
# DEBUG_IP=1                      # adds GET /debug/ip. Use it once. Then remove it